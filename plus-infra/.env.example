# ─── Ports ───────────────────────────────────────────────────────────────────
MS_AUTH_PORT=3001
MFE_AUTH_PORT=4001
SHELL_PORT=3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ─── AWS / Ministack (LocalStack) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566

# ─── RDS (provisionado pelo Ministack via Terraform) ─────────────────────────
# IMPORTANTE: o Ministack cria automaticamente um container Postgres real com
# este nome quando o Terraform aplica aws_db_instance. NÃO use "localhost" —
# dentro do Docker, "localhost" seria o próprio container do ms-auth.
DB_HOST=ministack-rds-plus-auth-db
DB_PORT=5432
DB_USER=plus
DB_PASSWORD=plus_secret
DB_NAME=plus_auth